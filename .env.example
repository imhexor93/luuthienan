# ── Anthropic API Key ─────────────────────────────────────────────────────────
# BẮT BUỘC — dùng cho AI Chat và phân tích Excel bảng thành phần
# Lấy key tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Cấu hình server (không cần đổi nếu dùng Docker) ──────────────────────────
NODE_ENV=production
PORT=3001
DB_PATH=/app/data/rd_projects.db

# ── Bảo mật ───────────────────────────────────────────────────────────────────
# Thay bằng chuỗi ngẫu nhiên bất kỳ (ít nhất 32 ký tự)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
